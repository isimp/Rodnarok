<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the parts of Rodnarok that need no game: which fish a bait brings, when a fish
       counts as at the float, the hook window, holding the line through a fight, how long a fish
       takes to come, the crosshair ring's state and which water corners a calming item stand
       reaches. The model has no Unity or BepInEx reference, so nothing else is needed to build it
       here.
       Run with: dotnet test tests/Rodnarok.Tests -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Rodnarok.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/Model/*.cs" />
    <Compile Include="../../selftest/Model/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- The standards tests compile Rodnarok's whole source as the build does, with the reference
       copies in lib/ and the .NET Framework 4.7.2 reference assemblies, and read it with the
       compiler's own types (the compiler version the SDK builds with). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" GeneratePathProperty="true" ExcludeAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Net472References</_Parameter1>
      <_Parameter2>$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net472)/build/.NETFramework/v4.7.2</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
