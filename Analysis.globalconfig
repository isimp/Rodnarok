is_global = true

# The .NET code analysis rules Rodnarok turns off, each for what it misreads here. Every other rule
# runs and fails the build (BuildChecks.props).

# Unity's objects compare equal to null once destroyed, which flow analysis does not know: a
# null check after a pattern match ("is Fish fish && fish != null") is how a destroyed one is
# skipped, not dead code.
dotnet_diagnostic.CA1508.severity = none

# Unity calls its messages (Update, FixedUpdate, OnDestroy) on the instance, by name; they cannot
# be static.
dotnet_diagnostic.CA1822.severity = none

# A BepInEx plugin's id is a dotted name ("isimp.Rodnarok"), not a GUID, whatever its parameter is
# called, and BepInEx names it GUID.
dotnet_diagnostic.CA2243.severity = none
dotnet_diagnostic.CA1720.severity = none

# Rodnarok lowers case only for words it shows; it never compares by changing case.
dotnet_diagnostic.CA1308.severity = none

# Random rolls pick which fish comes and when, as the game's own fish do; they guard nothing.
dotnet_diagnostic.CA5394.severity = none

# Rodnarok offers no API, so its few
# exceptions, made and caught by Rodnarok alone, need no public type or set of constructors.
dotnet_diagnostic.CA1032.severity = none
dotnet_diagnostic.CA1064.severity = none
